/* =========================================================
   YUSUF ANIME
   RESPONSIVE CSS
   Mobile • Tablet • Desktop
========================================================= */


/* =========================================================
   LARGE DESKTOP
========================================================= */

@media (min-width: 1400px) {

  .container,
  .header-container,
  .hero-container {
    max-width: 1320px;
  }

  .hero-title {
    font-size: 76px;
  }

  .hero-description {
    max-width: 680px;
    font-size: 18px;
  }

  .anime-grid {
    grid-template-columns: repeat(6, 1fr);
  }

  .genre-grid {
    grid-template-columns: repeat(4, 1fr);
  }

}


/* =========================================================
   DESKTOP
========================================================= */

@media (max-width: 1199px) {

  .container,
  .header-container,
  .hero-container {
    width: min(94%, 1100px);
  }

  .desktop-navigation {
    gap: 18px;
  }

  .nav-link {
    font-size: 14px;
  }

  .header-actions {
    gap: 8px;
  }

  .account-text {
    display: none;
  }

  .account-button {
    width: 42px;
    height: 42px;
    padding: 0;
    justify-content: center;
  }

  .language-button span:nth-child(2) {
    display: none;
  }

  .hero-title {
    font-size: 62px;
  }

  .hero-content {
    max-width: 700px;
  }

  .anime-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .genre-grid {
    grid-template-columns: repeat(4, 1fr);
  }

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 991px) {

  body {
    overflow-x: hidden;
  }

  .container,
  .header-container,
  .hero-container {
    width: min(92%, 850px);
  }


  /* -------------------------
     HEADER
  ------------------------- */

  .site-header {
    height: 70px;
  }

  .header-container {
    height: 70px;
  }

  .desktop-navigation {
    display: none;
  }

  .mobile-menu-button {
    display: flex;
  }

  .header-actions {
    margin-left: auto;
  }

  .language-selector {
    position: relative;
  }

  .language-button {
    min-width: 44px;
    padding: 0 10px;
  }


  /* -------------------------
     HERO
  ------------------------- */

  .hero-section {
    min-height: 650px;
  }

  .hero-container {
    min-height: 650px;
  }

  .hero-content {
    max-width: 650px;
    padding-top: 70px;
  }

  .hero-title {
    font-size: clamp(48px, 7vw, 64px);
    line-height: 1.05;
  }

  .hero-description {
    font-size: 16px;
    max-width: 580px;
  }

  .hero-stats {
    gap: 35px;
  }


  /* -------------------------
     CATEGORIES
  ------------------------- */

  .category-scroll {
    overflow-x: auto;
    justify-content: flex-start;
    padding-bottom: 8px;
    scrollbar-width: none;
  }

  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  .category-scroll button {
    flex: 0 0 auto;
  }


  /* -------------------------
     SECTIONS
  ------------------------- */

  .content-section {
    padding: 70px 0;
  }

  .section-heading {
    gap: 25px;
  }

  .section-heading h2 {
    font-size: 32px;
  }


  /* -------------------------
     ANIME GRID
  ------------------------- */

  .anime-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }


  /* -------------------------
     GENRES
  ------------------------- */

  .genre-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }


  /* -------------------------
     DETAILS MODAL
  ------------------------- */

  .details-container {
    width: 94%;
    max-height: 92vh;
  }

  .details-body {
    padding: 25px;
  }

  .details-poster {
    width: 180px;
    min-width: 180px;
  }

  .details-information h1 {
    font-size: 34px;
  }

}


/* =========================================================
   MOBILE LARGE
========================================================= */

@media (max-width: 767px) {

  html {
    scroll-behavior: smooth;
  }

  .container,
  .header-container,
  .hero-container {
    width: calc(100% - 30px);
  }


  /* -------------------------
     HEADER
  ------------------------- */

  .site-header {
    height: 64px;
  }

  .header-container {
    height: 64px;
  }

  .brand {
    font-size: 18px;
  }

  .header-actions {
    gap: 5px;
  }

  .icon-button {
    width: 38px;
    height: 38px;
  }

  .language-selector {
    display: none;
  }

  .account-area {
    display: none;
  }

  .mobile-menu-button {
    width: 40px;
    height: 40px;
  }


  /* -------------------------
     MOBILE MENU
  ------------------------- */

  .mobile-menu {
    width: min(320px, 88vw);
  }

  .mobile-navigation {
    padding: 20px;
  }

  .mobile-navigation a {
    padding: 14px 16px;
    font-size: 15px;
  }


  /* -------------------------
     HERO
  ------------------------- */

  .hero-section {
    min-height: 650px;
  }

  .hero-container {
    min-height: 650px;
    align-items: flex-end;
  }

  .hero-content {
    padding: 60px 0 65px;
    max-width: 100%;
  }

  .hero-badge {
    font-size: 11px;
    padding: 8px 12px;
  }

  .hero-title {
    font-size: clamp(42px, 12vw, 58px);
    line-height: 1.02;
    margin: 18px 0;
  }

  .hero-description {
    font-size: 15px;
    line-height: 1.7;
  }

  .hero-actions {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    margin-top: 25px;
  }

  .hero-actions .button {
    width: 100%;
    justify-content: center;
  }

  .hero-stats {
    width: 100%;
    justify-content: space-between;
    gap: 10px;
    margin-top: 35px;
  }

  .hero-stat {
    flex: 1;
  }

  .hero-stat strong {
    font-size: 24px;
  }

  .hero-stat span {
    font-size: 11px;
  }


  /* -------------------------
     QUICK CATEGORIES
  ------------------------- */

  .quick-categories {
    padding: 12px 0;
  }

  .category-scroll {
    gap: 8px;
  }

  .category-scroll button {
    padding: 10px 14px;
    font-size: 13px;
  }


  /* -------------------------
     SECTIONS
  ------------------------- */

  .content-section {
    padding: 55px 0;
  }

  .section-heading {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    font-size: 28px;
    margin-top: 6px;
  }

  .section-heading p {
    font-size: 14px;
  }

  .section-link-button,
  .section-link {
    font-size: 13px;
  }


  /* -------------------------
     ANIME GRID
  ------------------------- */

  .anime-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }


  /* -------------------------
     GENRES
  ------------------------- */

  .genre-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .genre-card {
    min-height: 150px;
    padding: 18px 12px;
  }

  .genre-icon {
    font-size: 30px;
  }

  .genre-card strong {
    font-size: 15px;
  }

  .genre-card small {
    font-size: 11px;
  }


  /* -------------------------
     SEARCH MODAL
  ------------------------- */

  .search-modal {
    width: calc(100% - 24px);
    max-height: 90vh;
    padding: 18px;
  }

  .search-modal-header h2 {
    font-size: 20px;
  }

  .search-form {
    flex-direction: column;
    gap: 10px;
  }

  .search-form input,
  .search-form button {
    width: 100%;
  }

  .search-filters {
    overflow-x: auto;
    flex-wrap: nowrap;
    scrollbar-width: none;
  }

  .search-filters::-webkit-scrollbar {
    display: none;
  }

  .search-filter {
    flex: 0 0 auto;
  }


  /* -------------------------
     DETAILS MODAL
  ------------------------- */

  .details-modal {
    padding: 10px;
  }

  .details-container {
    width: 100%;
    max-height: 94vh;
    border-radius: 16px;
  }

  .details-hero {
    height: 190px;
  }

  .details-body {
    flex-direction: column;
    padding: 20px;
    margin-top: 0;
  }

  .details-poster {
    width: 130px;
    min-width: 130px;
    height: 190px;
    margin: -65px auto 5px;
    position: relative;
    z-index: 3;
  }

  .details-information {
    width: 100%;
    text-align: center;
  }

  .details-information h1 {
    font-size: 27px;
    margin-top: 12px;
  }

  .details-meta {
    justify-content: center;
    flex-wrap: wrap;
  }

  .details-genres {
    justify-content: center;
    flex-wrap: wrap;
  }

  .details-description {
    font-size: 14px;
    line-height: 1.7;
    text-align: left;
  }

  .details-actions {
    flex-direction: column;
  }

  .details-actions .button {
    width: 100%;
    justify-content: center;
  }

  .episodes-section {
    padding: 20px;
  }

  .episodes-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .episode-grid {
    grid-template-columns: repeat(3, 1fr);
  }


  /* -------------------------
     CTA
  ------------------------- */

  .cta-section {
    padding: 70px 0;
  }

  .cta-content h2 {
    font-size: 34px;
  }

  .cta-content p {
    font-size: 14px;
    line-height: 1.7;
  }


  /* -------------------------
     FOOTER
  ------------------------- */

  .footer-main {
    grid-template-columns: 1fr 1fr;
    gap: 35px 20px;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .footer-bottom-links {
    flex-wrap: wrap;
  }


  /* -------------------------
     BACK TO TOP
  ------------------------- */

  .back-to-top {
    width: 42px;
    height: 42px;
    right: 15px;
    bottom: 15px;
  }

}


/* =========================================================
   MOBILE SMALL
========================================================= */

@media (max-width: 480px) {

  .container,
  .header-container,
  .hero-container {
    width: calc(100% - 24px);
  }


  /* -------------------------
     HEADER
  ------------------------- */

  .brand-main {
    font-size: 17px;
  }

  .brand-accent {
    font-size: 17px;
  }

  .header-actions {
    gap: 3px;
  }

  .icon-button {
    width: 35px;
    height: 35px;
    font-size: 15px;
  }

  .mobile-menu-button {
    width: 37px;
    height: 37px;
  }


  /* -------------------------
     HERO
  ------------------------- */

  .hero-section {
    min-height: 610px;
  }

  .hero-container {
    min-height: 610px;
  }

  .hero-content {
    padding-bottom: 50px;
  }

  .hero-title {
    font-size: 42px;
  }

  .hero-description {
    font-size: 14px;
  }

  .hero-stats {
    margin-top: 28px;
  }

  .hero-stat strong {
    font-size: 21px;
  }


  /* -------------------------
     ANIME GRID
  ------------------------- */

  .anime-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }


  /* -------------------------
     GENRES
  ------------------------- */

  .genre-grid {
    gap: 10px;
  }

  .genre-card {
    min-height: 135px;
    padding: 15px 8px;
  }

  .genre-icon {
    font-size: 26px;
  }


  /* -------------------------
     DETAILS
  ------------------------- */

  .details-hero {
    height: 160px;
  }

  .details-poster {
    width: 110px;
    min-width: 110px;
    height: 160px;
    margin-top: -50px;
  }

  .details-information h1 {
    font-size: 24px;
  }

  .episode-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }


  /* -------------------------
     FOOTER
  ------------------------- */

  .footer-main {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .footer-brand {
    grid-column: auto;
  }

  .footer-bottom {
    font-size: 12px;
  }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 360px) {

  .brand-accent {
    display: none;
  }

  .hero-title {
    font-size: 38px;
  }

  .hero-stats {
    gap: 5px;
  }

  .hero-stat strong {
    font-size: 19px;
  }

  .hero-stat span {
    font-size: 10px;
  }

  .anime-grid {
    gap: 8px;
  }

  .genre-card {
    min-height: 125px;
  }

}


/* =========================================================
   LANDSCAPE MOBILE
========================================================= */

@media (max-height: 550px) and (orientation: landscape) {

  .hero-section,
  .hero-container {
    min-height: 560px;
  }

  .hero-content {
    padding-top: 80px;
    padding-bottom: 40px;
  }

  .hero-title {
    font-size: 42px;
  }

  .hero-description {
    max-width: 600px;
  }

  .hero-actions {
    flex-direction: row;
  }

  .hero-actions .button {
    width: auto;
  }

}


/* =========================================================
   TOUCH DEVICES
========================================================= */

@media (hover: none) and (pointer: coarse) {

  .nav-link,
  .button,
  .icon-button,
  .genre-card,
  .category-scroll button,
  .mobile-navigation a,
  .search-filter {
    -webkit-tap-highlight-color: transparent;
  }

  .button,
  .icon-button,
  .genre-card,
  .category-scroll button {
    transition: transform 0.15s ease;
  }

  .button:active,
  .icon-button:active,
  .genre-card:active,
  .category-scroll button:active {
    transform: scale(0.97);
  }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

}


/* =========================================================
   PRINT
========================================================= */

@media print {

  .site-header,
  .mobile-menu,
  .mobile-menu-overlay,
  .search-modal,
  .details-modal,
  .toast-container,
  .back-to-top,
  .site-footer {
    display: none !important;
  }

  body {
    background: #fff !important;
    color: #000 !important;
  }

  .hero-section {
    min-height: auto;
  }

  .content-section {
    page-break-inside: avoid;
  }

}
